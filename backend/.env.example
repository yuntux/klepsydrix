# Configuration de l'application Klepsydrix Backend
#
# La configuration de la base de données (SQLite/PostgreSQL) ne vit plus ici : voir
# instance.example.yaml à la racine du dépôt.

# Limite de temps accordée au solveur en secondes (par exemple 300 secondes)
SOLVER_TIME_LIMIT_SECONDS=300

# Limite d'inactivité/stagnation en secondes (s'arrête si aucune amélioration du score)
SOLVER_UNIMPROVED_TIME_LIMIT_SECONDS=10

# Nombre de résolutions Timefold simultanées, toutes bases confondues, avant mise en file
# d'attente (voir architecture.md, "Concurrence des résolutions"). Par défaut : nombre de cœurs de
# la machine.
# SOLVER_MAX_CONCURRENT_SOLVES=4

# Borne explicite du tas JVM (-Xmx), en Mo — protège contre l'épuisement de la RAM de l'hôte si
# plusieurs résolutions tournent en même temps.
SOLVER_JVM_MAX_HEAP_MB=2048
