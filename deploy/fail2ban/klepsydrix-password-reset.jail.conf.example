# Exemple de jail fail2ban pour klepsydrix-password-reset.conf — voir architecture.md §17.G/§17.H.
# Installation : voir klepsydrix-master-auth.jail.conf.example (même marche à suivre).
#
# Un plancher applicatif existe en plus (core/rate_limit.py, `auth.rate_limit_attempts`) : cette
# jail n'est donc plus la seule protection, mais elle reste préférable — elle agit au niveau réseau,
# avant que la requête n'atteigne l'application.

[klepsydrix-password-reset]
enabled  = true
filter   = klepsydrix-password-reset
logpath  = /var/log/klepsydrix/backend.log
backend  = auto

# Une demande légitime est un événement RARE (on oublie son mot de passe quelques fois par an), et
# une rafale n'a aucune explication innocente — d'où un seuil plus bas que pour la connexion locale
# (8/15min), tout en laissant la place à un utilisateur qui reclique parce que l'email tarde.
maxretry = 5
findtime = 15m
bantime  = 1h

# bantime.increment = true
# bantime.factor    = 4
# bantime.maxtime   = 1w

# ignoreip = 127.0.0.1/8 ::1
